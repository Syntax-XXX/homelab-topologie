    { "from": "server-1", "to": "pihole", "type": "vm" },
    { "from": "server-2", "to": "media", "type": "vm" },
    { "from": "docker", "to": "nginx", "type": "ct" },
    { "from": "docker", "to": "grafana", "type": "ct" },
    { "from": "docker", "to": "jellyfin", "type": "ct" }
