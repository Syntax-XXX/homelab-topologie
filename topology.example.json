    { "id": "server-1", "kind": "server", "name": "server-1", "print": "PROXMOX · NODE 1", "ip": "192.168.1.10" },
    { "id": "server-2", "kind": "server", "name": "server-2", "print": "PROXMOX · NODE 2", "ip": "192.168.1.11" },
    { "id": "nas", "kind": "nas", "name": "nas", "print": "NAS", "disks": 3, "ip": "192.168.1.20", "info": { "Speicher": "3 × 8 TB" } },
    { "id": "docker", "kind": "guest", "name": "docker", "host": "server-1", "sub": "VM 100" },
    { "id": "pihole", "kind": "guest", "name": "pihole", "host": "server-1", "sub": "LXC 101", "lxc": true },
    { "id": "media", "kind": "guest", "name": "media", "host": "server-2", "sub": "VM 200" },
    { "id": "nginx", "kind": "ct", "name": "nginx", "host": "docker" },
    { "id": "grafana", "kind": "ct", "name": "grafana", "host": "docker" },
    { "id": "jellyfin", "kind": "ct", "name": "jellyfin", "host": "docker" }
